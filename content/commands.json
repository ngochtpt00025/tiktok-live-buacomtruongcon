{
  "_note": "Pattern viết KHÔNG DẤU, chữ thường (comment được chuẩn hoá trước khi so). Thứ tự = độ ưu tiên. Regex JavaScript.",
  "intents": [
    {
      "intent": "JOIN",
      "patterns": [
        "^(nhap|vao) ?tiec\\b",
        "^nt$",
        "^vao$",
        "^join$"
      ]
    },
    {
      "intent": "MOVE_TABLE",
      "patterns": [
        "\\bmam ?(\\d{1,2})\\b",
        "\\bban ?(\\d{1,2})\\b"
      ]
    },
    {
      "intent": "LEAVE",
      "patterns": [
        "^(ra ve|ve thoi|ve day|xin phep ve|bye)\\b"
      ]
    },
    {
      "intent": "VOTE_AB",
      "patterns": [
        "^(a|b)$",
        "^phe (a|b)\\b",
        "^chon (a|b)$"
      ]
    },
    {
      "intent": "TEAR",
      "patterns": [
        "^xe\\b",
        "\\bxe ga\\b",
        "\\bxe thit\\b"
      ]
    },
    {
      "intent": "STORY",
      "patterns": [
        "\\bke chuyen\\b",
        "\\bke truyen\\b"
      ]
    },
    {
      "intent": "INVITE",
      "patterns": [
        "\\bmoi chu\\b",
        "\\bchu an di\\b",
        "\\bchu ngoi di\\b"
      ]
    },
    {
      "intent": "SHOO",
      "patterns": [
        "^duoi\\b",
        "^di di\\b",
        "\\bduoi chu\\b"
      ]
    },
    {
      "intent": "VOTE",
      "patterns": [
